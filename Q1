-- Q1 PART 1 & 2
DECLARE
    today DATE := SYSDATE;
    tomorrow today%TYPE;
BEGIN
    tomorrow := today + 1;
    
    DBMS_OUTPUT.PUT_LINE('Hello World');
    DBMS_OUTPUT.PUT_LINE('Today: ' || today);
    DBMS_OUTPUT.PUT_LINE('Tomorrow: ' || tomorrow);
END;
/

-- Q1 PART 3
DECLARE
    my_date DATE;
    v_last_day DATE;
BEGIN
    my_date := SYSDATE;
    v_last_day := LAST_DAY(my_date);
    
    DBMS_OUTPUT.PUT_LINE(TO_CHAR(my_date, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Last day: ' || v_last_day);
END;
/
 
-- Q1 PART 4
DECLARE
    my_date  DATE := SYSDATE;
    future_date DATE;
    months_bet  NUMBER;
BEGIN
    future_date := my_date + 45;
    months_bet  := MONTHS_BETWEEN(future_date, my_date);
    
    DBMS_OUTPUT.PUT_LINE('Today: ' || TO_CHAR(my_date, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Future date: ' || TO_CHAR(future_date, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Months between: ' || ROUND(months_bet, 2));
END;
/
