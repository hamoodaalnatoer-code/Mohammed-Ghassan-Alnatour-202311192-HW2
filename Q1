-- Q1 PART 1 & 2
DECLARE
    v_today    DATE := SYSDATE;
    v_tomorrow v_today%TYPE;
BEGIN
    v_tomorrow := v_today + 1;
    
    DBMS_OUTPUT.PUT_LINE('Hello World');
    DBMS_OUTPUT.PUT_LINE('Today: ' || v_today);
    DBMS_OUTPUT.PUT_LINE('Tomorrow: ' || v_tomorrow);
END;
/

-- Q1 PART 3
DECLARE
    v_my_date   DATE;
    v_month_end DATE;
BEGIN
    v_my_date   := SYSDATE;
    v_month_end := LAST_DAY(v_my_date);
    
    DBMS_OUTPUT.PUT_LINE(TO_CHAR(v_my_date, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Last day: ' || v_month_end);
END;
/
 
-- Q1 PART 4
DECLARE
    v_current_dt DATE := SYSDATE;
    v_future_dt  DATE;
    v_diff_m     NUMBER;
BEGIN
    v_future_dt := v_current_dt + 45;
    v_diff_m    := MONTHS_BETWEEN(v_future_dt, v_current_dt);
    
    DBMS_OUTPUT.PUT_LINE('Today: ' || TO_CHAR(v_current_dt, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Future date: ' || TO_CHAR(v_future_dt, 'Month dd, yyyy'));
    DBMS_OUTPUT.PUT_LINE('Months between: ' || ROUND(v_diff_m, 2));
END;
/
