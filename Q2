-- Q2 CREATE TABLE
CREATE TABLE countries (
    country_name VARCHAR2(50),
    median_age NUMBER(6,2)
);
 
INSERT INTO countries VALUES('Japan', 48.70);
INSERT INTO countries VALUES('Germany', 47.80);
INSERT INTO countries VALUES('Italy', 47.30);
INSERT INTO countries VALUES('China', 38.40);
INSERT INTO countries VALUES('India', 27.90);
 
COMMIT;
 
-- Q2 USING %TYPE ATTRIBUTE
DECLARE
    country_name countries.country_name%TYPE;
    median_age countries.median_age%TYPE;
BEGIN
    SELECT country_name, median_age INTO country_name, median_age 
    FROM countries 
    WHERE country_name = 'Japan';
    
    DBMS_OUTPUT.PUT_LINE('The median age in ' || country_name || ' is ' || median_age || '.');
END;
/
 
-- Q2 USING EXPLICIT CURSOR
DECLARE
    CURSOR cur_countries IS 
        SELECT country_name, median_age FROM countries 
        WHERE country_name = 'Japan';
    
    country_name countries.country_name%TYPE;
    median_age countries.median_age%TYPE;
BEGIN
    OPEN cur_countries;
    FETCH cur_countries INTO country_name, median_age;
    
    IF cur_countries%FOUND THEN
        DBMS_OUTPUT.PUT_LINE('The median age in ' || country_name || ' is ' || median_age || '.');
    ELSE
        DBMS_OUTPUT.PUT_LINE('Country not found');
    END IF;
    
    CLOSE cur_countries;
END;
/
